# 필수 — 직접 PostgreSQL 연결 URI. 비밀값은 서버 환경에만 보관.
DATABASE_URL=postgresql://bookmark_api:password@localhost:5432/postgres?sslmode=require

# 리소스 및 /api/v1/auth/me 호출 키 (X-Bookmark-Key)
# 예: openssl rand -hex 32
BOOKMARK_API_KEY=

# 선택 UUID. 빈 DB 시작 또는 여러 소유자 중 특정 소유자 운영 시 명시.
# 미설정: items/folders/sections/folder_sections 전체의 유일 소유자만 허용.
# 데이터 없음·복수 소유자는 service_identity_unavailable (503).
BOOKMARK_USER_ID=

# 테스트 전용. localhost/127.0.0.1/::1의 *_test DB만 허용.
DATABASE_TEST_URL=
